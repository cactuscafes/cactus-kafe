# Tasarim MCP sunuculari icin anahtarlar.
# Kopyala:  cp .env.example .env   (.env git'e girmez, .gitignore'da)
# Kullanim: set -a && source .env && set +a && claude
#
# UYARI: Anahtar bos birakilirsa sunucu BASLAMAZ (calis ama islev vermez degil).
# Olculen hatalar:
#   nano-banana -> "GEMINI_API_KEY environment variable is required"
#   stitch      -> "StitchProxy requires an API key (STITCH_API_KEY) or access token"

# Google AI Studio -> https://aistudio.google.com/apikey
# Gorsel uretimi ucretli katman ister (anahtarin kendisi ucretsiz).
GEMINI_API_KEY=

# https://21st.dev/mcp -> API key
# Eski Magic konsolundan alinan anahtarlar sifirlandi, yenisini buradan uret.
API_KEY_21ST=

# Stitch icin IKI yol var, birini sec:
#
#   A) API anahtari (basit, CI/paylasilan config icin uygun)
#      Asagiyi doldur, baska bir sey gerekmez.
STITCH_API_KEY=
#
#   B) OAuth (gcloud uzerinden)
#      Anahtari bos birak, bunun yerine:
#        npx @_davideast/stitch-mcp init
#        npx @_davideast/stitch-mcp doctor    # gcloud, auth, ADC, proje kontrolu
#      Sistemde zaten gcloud varsa asagiyi 1 yap:
STITCH_USE_SYSTEM_GCLOUD=
