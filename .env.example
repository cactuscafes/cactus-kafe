# Tasarim MCP sunuculari icin anahtarlar.
# Kopyala:  cp .env.example .env   (.env git'e girmez, .gitignore'da)
# Kullanim: set -a && source .env && set +a && claude

# Google AI Studio -> https://aistudio.google.com/apikey
# Nano Banana / Nano Banana Pro gorsel uretimi icin. Gorsel uretimi ucretli katman ister.
GEMINI_API_KEY=

# https://21st.dev/mcp -> API key
# 21st MCP (eski adiyla Magic): React/Tailwind bilesen katalogu + UI uretimi.
API_KEY_21ST=

# Stitch icin anahtar SART DEGIL: `npx @_davideast/stitch-mcp init` OAuth ile halleder.
# Anahtarla gitmek istersen asagidakini doldur ve kabugunda export et.
# STITCH_API_KEY=
