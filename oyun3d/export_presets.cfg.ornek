; Dışa aktarım şablonu — ÖRNEK.
;
;   cp export_presets.cfg.ornek export_presets.cfg
;
; Gerçek dosya .gitignore'da: Godot bu dosyaya Android imza anahtarının
; parolasını da yazar, o yüzden depoya asla girmemeli. Şablon burada durur ki
; yeni bir makinede aynı üç hedefi tek komutla kurabilesin.
;
; Godot bu dosyayı ilk açılışta kendi varsayılanlarıyla tamamlar.

[preset.0]

name="Windows"
platform="Windows Desktop"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="../cikti/windows/cactus3d.exe"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

binary_format/embed_pck=false
binary_format/architecture="x86_64"
application/icon=""
application/product_name="Cactus 3B"
application/company_name="Cactus Cafe"
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false

[preset.1]

name="Web"
platform="Web"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="../cikti/web/index.html"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.1.options]

variant/extensions_support=false
variant/thread_support=true
vram_texture_compression/for_desktop=true
vram_texture_compression/for_mobile=true
html/export_icon=true
html/canvas_resize_policy=2
progressive_web_app/enabled=false

[preset.2]

name="Android"
platform="Android"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="../cikti/android/cactus3d.apk"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.2.options]

gradle_build/use_gradle_build=false
package/unique_name="com.cactuscafes.oyun3d"
package/name="Cactus 3B"
package/signed=true
version/code=1
version/name="0.1.0"
screen/immersive_mode=true
screen/support_small=true
screen/support_normal=true
screen/support_large=true
screen/support_xlarge=true
architectures/armeabi-v7a=false
architectures/arm64-v8a=true
architectures/x86_64=false
