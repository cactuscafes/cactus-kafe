; Cactus 3B — Faz 0
; Bu dosyayı Godot editörü kendisi yönetir; elle düzenlerken dikkatli ol.

config_version=5

[application]

config/name="Cactus 3B — Faz 0"
config/description="Merhaba küp: kamera, ışık, zemin ve hareket eden bir karakter."
run/main_scene="res://sahneler/ana.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Girdi="*res://betikler/girdi.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
; Web ve Android ön ayarlarındaki VRAM doku sıkıştırması bu iki ayarı şart koşar.
; Kapalıyken dışa aktarım "configuration errors" diyerek durur.
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
