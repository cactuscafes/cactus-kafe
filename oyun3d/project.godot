; Cactus 3B — Faz 0
; Bu dosyayı Godot editörü kendisi yönetir; elle düzenlerken dikkatli ol.

config_version=5

[application]

config/name="Cactus 3B"
config/description="Çölde zıpla, çiçekleri topla, dikenli düşmanların üstüne bin."
config/version="0.16.0"
run/main_scene="res://sahneler/ana_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Girdi="*res://betikler/girdi.gd"
Ses="*res://betikler/ses.gd"
Ayarlar="*res://betikler/ayarlar.gd"
Efekt="*res://betikler/efekt.gd"
Bolumler="*res://betikler/bolumler.gd"
Ag="*res://betikler/ag/ag.gd"
Urun="*res://betikler/urun.gd"
Telemetri="*res://betikler/telemetri.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; Dokunuşlar fare olayına ÇEVRİLMESİN: açık kaldığında hareket çubuğunu
; sürüklemek aynı anda fare hareketi üretiyor ve kamerayı da döndürüyor.
; Godot Control'leri dokunuşu zaten doğrudan işliyor, menüler etkilenmiyor.
pointing/emulate_mouse_from_touch=false

[internationalization]

locale/translations=PackedStringArray("res://arayuz/ceviriler.tr.translation", "res://arayuz/ceviriler.en.translation")
locale/fallback="tr"

[layer_names]

3d_physics/layer_1="zemin"
3d_physics/layer_2="oyuncu"
3d_physics/layer_3="tuzak"
3d_physics/layer_4="toplanabilir"
3d_physics/layer_5="kontrol"
3d_physics/layer_6="platform"
; Faz 14: düşman gövdeleri ve atıcının dikeni.
3d_physics/layer_7="dusman"
3d_physics/layer_8="mermi"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
; Gölge atlası doku belleğinin en büyük kalemi. 4096 bu stilde görülmüyor;
; 2048 masaüstünde, 1024 mobilde yeter.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
; Web ve Android ön ayarlarındaki VRAM doku sıkıştırması bu iki ayarı şart koşar.
; Kapalıyken dışa aktarım "configuration errors" diyerek durur.
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
